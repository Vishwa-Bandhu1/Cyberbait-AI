# Application
spring.application.name=Cyberbait-backend
server.port=${PORT:8080}
server.address=0.0.0.0

# MongoDB Atlas
# Set MONGODB_URI in your environment. Do not commit real credentials.
spring.mongodb.uri=${MONGODB_URI}
spring.data.mongodb.uri=${MONGODB_URI}
spring.data.mongodb.auto-index-creation=${MONGODB_AUTO_INDEX_CREATION:true}
app.mongodb.verify-on-startup=${MONGODB_VERIFY_ON_STARTUP:true}

# MIET AI Gateway API
ai.gateway.url=${AI_GATEWAY_URL:https://ai-services.mietjmu.in/gateway/llm/chat}
ai.gateway.token=${AI_GATEWAY_TOKEN:}
ai.gateway.model=${AI_GATEWAY_MODEL:gpt-oss:20b}

# File Upload
spring.servlet.multipart.max-file-size=${MAX_FILE_SIZE:10MB}
spring.servlet.multipart.max-request-size=${MAX_REQUEST_SIZE:10MB}

# Tesseract
tesseract.data.path=${TESSERACT_DATA_PATH:/usr/share/tesseract-ocr/5/tessdata}

# CORS
app.cors.allowed-origins=${APP_CORS_ALLOWED_ORIGINS:*}

# Logging
logging.level.org.mongodb.driver.cluster=${MONGODB_DRIVER_CLUSTER_LOG_LEVEL:WARN}
